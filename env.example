# Meta Cloud API Config (WhatsApp Official API)
# Este token de verificação é criado por VOCÊ. Use o mesmo valor no Painel da Meta -> Webhooks
META_WEBHOOK_VERIFY_TOKEN=heavyflow123

# Token de Acesso Permanente (Gerado em Usuários do Sistema -> Gerar Token)
# Permissões necessárias: whatsapp_business_messaging e whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=

# ID da Conta do WhatsApp Business (WABA ID)
# Pode ser o da conta Oficial ou da 'Test WhatsApp Business Account'
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ID do Número de Telefone
# Deve corresponder à conta escolhida acima (pode ser o Test Number)
WHATSAPP_PHONE_NUMBER_ID=

# Detalhes do Aplicativo Meta (Configurações -> Básico)
META_APP_ID=
META_APP_SECRET=

# Stripe Billing (Assinaturas)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:7.@k*3.(NmLacLSd@34.48.38.198:5432/whatscrm-4037d-database

